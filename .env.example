# ---------------------------------------------------------------------------
# Trilite environment.
# Copy to `.env.local` for local development. NEVER commit a filled-in file.
# Values prefixed EXPO_PUBLIC_ are embedded in the app bundle and are therefore
# public by design — only ever put publishable client keys here.
# ---------------------------------------------------------------------------

# --- RevenueCat (Project settings -> API keys -> "Public app-specific keys")
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Google AdMob -----------------------------------------------------------
# App IDs are baked into the native manifests at build time (not EXPO_PUBLIC_).
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
# Ad unit IDs are read at runtime. Leave blank to use Google's test units.
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=

# --- EAS --------------------------------------------------------------------
EAS_PROJECT_ID=
EXPO_OWNER=

# --- Build variant: development | preview | production ----------------------
APP_VARIANT=development
